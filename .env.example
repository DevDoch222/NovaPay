# NovaPay API — copy to apps/api/.env and fill in values
# Never commit real secrets.

NODE_ENV=development
PORT=3000
APP_NAME=novapay-api
APP_URL=http://localhost:3000

# Supabase Postgres
# Project Settings → Database → Connection string
# Runtime: Transaction pooler (port 6543) — use as DATABASE_URL
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Migrations: Direct connection (port 5432) — use as DATABASE_URL_DIRECT
DATABASE_URL_DIRECT=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Or use the "Direct connection" host: db.[PROJECT_REF].supabase.co:5432

# Redis (local docker-compose or managed)
REDIS_URL=redis://localhost:6379

# Auth (placeholders — Phase 1)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Observability
LOG_LEVEL=info

# Feature flags / partner stubs (Phase 0 — unset until selected)
KYC_PROVIDER=
CARD_ISSUER=
BAAS_PROVIDER=
MOMO_AGGREGATOR=
FX_RATE_PROVIDER=
SANCTIONS_PROVIDER=

# Phase 1 sandbox helpers
OTP_DEV_FIXED_CODE=000000
OTP_PEPPER=novapay-dev-otp-pepper-change-me
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
SMS_OTP_MODE=log
# Infobip (set SMS_OTP_MODE=infobip and paste):
# INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# INFOBIP_API_KEY=
# INFOBIP_SENDER=NovaPay
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AUTH_STEPUP_PAYOUT_MINOR=50000000
AUTH_STEPUP_TTL_SECONDS=600
KYC_AUTO_APPROVE=true

# Flutterwave (NGN rail)
PAYMENT_RAIL=auto
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3

# Phase 2 FX / cards
FX_USD_NGN_MID=1600
FX_USD_EUR_MID=0.92
FX_MARGIN_BPS=150
FX_QUOTE_TTL_SECONDS=60
CARD_ISSUER=mock

# Phase 5 — API hardening
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_PUBLIC_LIMIT=30
IDEMPOTENCY_TTL_SECONDS=86400
SWAGGER_ENABLED=true

# Phase 6 — Money / FX / fees
FX_RATE_MODE=static
FX_HTTP_URL=https://api.frankfurter.app/latest?from=USD&to=NGN,EUR
FX_RATE_CACHE_TTL_SECONDS=300
FEE_FUND_BPS=50
FEE_FUND_FLAT_MINOR=0
FEE_PAYOUT_BPS=100
FEE_PAYOUT_FLAT_MINOR=5000
FEE_CARD_SPEND_BPS=0
FEE_CARD_SPEND_FLAT_MINOR=0
FEE_CARD_ISSUE_FLAT_MINOR=0
FEE_BILL_BPS=0
FEE_BILL_FLAT_MINOR=0
FEE_MIN_MINOR=0
FEE_MAX_MINOR=0
